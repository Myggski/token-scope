{
  "name": "tokenscope",
  "productName": "TokenScope",
  "version": "1.0.9",
  "description": "See what your AI coding costs before and after: estimate tasks, measure what they really cost, and track spending across Claude Code, Codex, Cursor and OpenCode.",
  "keywords": [
    "ai",
    "llm",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "opencode",
    "mcp",
    "token-usage",
    "cost-tracking",
    "openrouter",
    "electron"
  ],
  "author": {
    "name": "Tomas Wallin"
  },
  "license": "MIT",
  "private": true,
  "main": "main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "electron .",
    "test": "node src/estimate.test.js && node src/claudelogs.test.js && node src/history.test.js && node src/insights.test.js && node src/codexlogs.test.js && node src/archive.test.js && node src/opencode-wsl.test.js && node src/cursor-hook.test.js && node src/cursor-records.test.js && node src/cursordb.test.js && node src/zed.test.js && node src/mcpcopy.test.js",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fzstd": "0.1.1",
    "sql.js": "1.12.0"
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tomaswallin.tokenscope",
    "productName": "TokenScope",
    "copyright": "Copyright \u00a9 2026 Tomas Wallin",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**",
      "data/**",
      "build/icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TokenScope",
      "runAfterFinish": true,
      "artifactName": "TokenScope-Setup-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Myggski",
        "repo": "token-scope",
        "releaseType": "release"
      }
    ]
  }
}
